{
  "name": "job-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Local vacancy database and application tracker",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "node src/migrate.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "marked": "^18.1.1",
    "pg": "^8.13.1"
  }
}
